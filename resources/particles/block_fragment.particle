# Small textured shard thrown off when a block breaks.
name: finevox:block_fragment
lifetime: 0.6-1.2
initial_speed: 1.5-4.0
velocity_bias: 0 2.5 0
gravity: 14.0
drag: 0.6
size: 0.08-0.14
size_end_scale: 0.6
start_tint: 1 1 1 1
end_tint: 1 1 1 0.2
atlas_region: block_fragment
billboard: camera
collides: true
kill_on_collision: false
restitution: 0.15
